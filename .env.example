# LLM provider used by default: "gemini", "groq" or "ollama" (switchable in the UI)
LLM_PROVIDER=gemini

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (local, https://ollama.com) — the model must support tool calling
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# FRED (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
# Optional: without it the FRED tools are disabled.
FRED_API_KEY=
